[Unit]
Description=EVIDA — Coleta e extração dos informativos Emater/RS
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/lib/evida
Environment=TZ=America/Sao_Paulo
ExecStart=/usr/bin/python3 /usr/local/share/evida/current/tools/sync_emater_repository.py --cron --db /var/lib/evida/var/evida.sqlite --storage /var/lib/evida/storage/documents
StandardOutput=journal
StandardError=journal
TimeoutStartSec=2h
MemoryMax=512M
CPUQuota=50%
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/evida
