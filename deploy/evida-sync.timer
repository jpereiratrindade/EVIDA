[Unit]
Description=EVIDA — Timer Semanal de Ingestão de Informativos Emater/RS
Documentation=https://github.com/jpereiratrindade/EVIDA

[Timer]
# Executa toda quinta-feira às 18:30 (horário de publicação semanal da Emater/RS)
OnCalendar=Thu *-*-* 18:30:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
